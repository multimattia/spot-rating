---
import PlaylistsToLoad from "@components/PlaylistsToLoad.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const spotifyUserResponse = await fetch(
  `https://api.spotify.com/v1/users/${Astro.locals.currentUser.spotifyId}/playlists?offset=0&limit=100`,
  {
    headers: {
      Authorization: `Bearer ${Astro.locals.accessToken}`,
    },
  }
);
let spotifyUserData;
if (spotifyUserResponse.ok) {
  spotifyUserData = await spotifyUserResponse.json();
} else {
  console.error(
    "error: ",
    spotifyUserResponse.status,
    spotifyUserResponse.statusText
  );
  spotifyUserData = [];
}
---

<BaseLayout title="Create a playlist" existingUser={Astro.locals.currentUser}>
  <PlaylistsToLoad playlistData={spotifyUserData.items} />
</BaseLayout>
