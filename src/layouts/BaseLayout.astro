---
import MenuBar from "@components/MenuBar.astro";
import "@styles/reset.css";
import "@styles/global.css";
import "@styles/base.css";
import "@styles/theme.css";
const { title, existingUser } = Astro.props;
import CommonHead from "@components/CommonHead.astro";
// const url = `${import.meta.env.PROD ? `https://${import.meta.env.PUBLIC_VERCEL_URL}/login/spotify/callback` : "http://localhost:4321/login/spotify/callback"}`;
// const url = import.meta.env.PROD ?
//   "https://" + import.meta.env.PUBLIC_VERCEL_URL + "/login/spotify/callback" :
//   "http://localhost:4321/login/spotify/callback";
const url = "http://localhost:4321/login/spotify/callback";
const token = Astro.locals.accessToken;
import { SpotifyPlayer } from "../components/react/SpotifyPlayer";
---

<html lang="en">
  <CommonHead title={title} />
  <body>
    <astro-token data-message={token}> </astro-token>
    {
      existingUser ? (
        <MenuBar existingUser={existingUser} />
      ) : (
        <MenuBar avatarUrl="" displayName="" />
      )
    }
    <main>
      <SpotifyPlayer client:only="react" token={token} transition:persist />
      <div class="dbcluster">
        <a href="/db/artistdb">artists</a>
        <a href="/db/songsdb">songs</a>
        <a href="/db/albumdb">albums</a>
        <a href="/db/playlistdb">playlists</a>
        <a href="/db/contributordb">contributors</a>
        <a href="/db/additionsdb">additions</a>
      </div>
      <slot />
    </main>
  </body><style>
    main {
      margin: 0 auto;
      width: var(--window-width);
      padding: 0 var(--space-m);
    }
    .dbcluster {
      display: flex;
      gap: var(--space-m);
      padding: 0;
      padding-top: var(--space-m);
    }
    .dbcluster a {
      text-decoration: none;
    }
    .dbcluster a:hover {
      text-decoration: underline;
    }
  </style>

</html>
